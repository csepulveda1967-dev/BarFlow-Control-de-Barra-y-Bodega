# Configuración de Supabase (Plan Gratuito)
# Copia estos valores desde Project Settings -> API en tu panel de Supabase
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Seguridad JWT (mínimo 32 caracteres en producción)
JWT_SECRET="CAMBIAR_ESTE_SECRETO_EN_PRODUCCION_MIN_32_CARACTERES"

# Credenciales de acceso por rol
ADMIN_EMAIL="asesorconsultorcasf@yahoo.com"
ADMIN_PASSWORD="123456"
BAR_EMAIL="csepulvedafuica@gmail.com"
BAR_PASSWORD="123456"

# Configuración general
EMPRESA_ID=1
PORT=3000
APP_URL="MY_APP_URL"

# Opcional si el frontend estático (ej. GitHub Pages) se aloja separado del backend
CORS_ORIGIN=""
VITE_API_BASE=""

# Opcional para modo estático directo a Supabase desde navegador (ej. GitHub Pages sin servidor Node)
# Solo usar la clave pública anon (NUNCA la service_role key en VITE_*)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_ADMIN_EMAIL=""
VITE_BAR_EMAIL=""
